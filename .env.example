# PayPal Sandbox Credentials (get these from developer.paypal.com dashboard)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Google Gemini API (get this from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud (get these from supabase.com dashboard under Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Channel3 E-commerce API (get free key with code PAYPAL-HACKATHON-2026 at trychannel3.com/developers)
CHANNEL3_API_KEY=your_channel3_api_key_here

# Internal Security & Orchestration (generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
INTERNAL_SERVICE_KEY=your_internal_service_bearer_token_here
