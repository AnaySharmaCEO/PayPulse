# ==============================================================================
# PayPulse Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# 1. PayPal Developer Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: Set when testing live PayPal webhook delivery; auto-simulates when omitted
PAYPAL_WEBHOOK_ID=

# 2. Google Gemini API Key (aistudio.google.com)
# Powers the Gemini 3.8 Flash AI Doctor for autonomous root-cause analysis
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase PostgreSQL Persistence (supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Channel3 Multi-Merchant E-Commerce API (trychannel3.com/developers)
# Optional: Live catalog queries; auto-falls back to seeded luxury catalog if empty
CHANNEL3_API_KEY=

# 5. Network & Port Configuration
PORT=3001
VITE_API_URL=http://localhost:3001
